{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "cleanUrls": false,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ai-landing-page-backend-demo.onrender.com/api/:path*"
    },
    {
      "source": "/auth/:path*",
      "destination": "https://ai-landing-page-backend-demo.onrender.com/auth/:path*"
    },
    {
      "source": "/projects/:path*",
      "destination": "https://ai-landing-page-backend-demo.onrender.com/projects/:path*"
    },
    {
      "source": "/deployments/:path*",
      "destination": "https://ai-landing-page-backend-demo.onrender.com/deployments/:path*"
    },
    {
      "source": "/templates/:path*",
      "destination": "https://ai-landing-page-backend-demo.onrender.com/templates/:path*"
    },
    {
      "source": "/versions/:path*",
      "destination": "https://ai-landing-page-backend-demo.onrender.com/versions/:path*"
    },
    {
      "source": "/",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/login",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/login.html",
      "destination": "/frontend/login.html"
    },
    {
      "source": "/index.html",
      "destination": "/frontend/index.html"
    },
    {
      "source": "/pages/:path*",
      "destination": "/frontend/pages/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/frontend/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/frontend/js/:path*"
    },
    {
      "source": "/assets/:path*",
      "destination": "/frontend/assets/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/$1"
    }
  ]
}
